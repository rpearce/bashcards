#!/usr/bin/env bash

set -eou pipefail

pname="bashcards"
ext="bcrds"

# nix/package.nix reads the version from this line
version="0.2.0"

# the deck being practiced: one `front=back` line per card
cards=()

# set by warn so we can pause before the screen is cleared
warned=0

function print_version {
  echo "$version"
  return 0
}

function usage {
  cat <<USAGE
Usage: $pname [OPTION...]

  -d, --dir DIRECTORY    Directory containing *.$ext files
  -h, --help             See this help information
  -v, --version          Current version
USAGE

  return 0
}

# prints a message to stderr, prefixed with the program name
function warn {
  printf '%s: %s\n' "$pname" "$*" >&2
  warned=1
  return 0
}

# prints a message to stderr and gives up
function die {
  warn "$@"
  exit 1
}

function unknown-cmd {
  warn "Sorry! I'm not sure what to do. Please use a known option."
  echo "" >&2
  usage >&2
  exit 1
}

# leaves the program when there's no more input (like ctrl-d)
function goodbye {
  echo ""
  exit 0
}

# card borders are measured in characters, which only
# works when the locale is UTF-8, so say so when it isn't
function check_locale {
  local locale="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"

  if [[ "$locale" != *[Uu][Tt][Ff]* ]]; then
    warn "Your locale (${locale:-unset}) isn't UTF-8, so card borders may not line up."
  fi

  return 0
}

# to_filename transforms `/path/to/file.ext` to `file`
function to_filename {
  local full_filename="${1##*/}"
  local filename="${full_filename%.*}"

  printf '%s\n' "$filename"

  return 0
}

# builds the card output; for example:
# ––––––––––––––––
# |              |
# |  Te quiero.  |
# |              |
# ––––––––––––––––
function make_card {
  local content="$1"
  local hborder
  local vborder

  printf -v hborder '%*s' $(( ${#content} + 6 )) ''
  printf -v vborder '%*s' $(( ${#content} + 4 )) ''
  hborder="${hborder// /–}"
  vborder="|$vborder|"

  echo ""
  printf '%s\n' "$hborder"
  printf '%s\n' "$vborder"
  printf '%s\n' "|  $content  |"
  printf '%s\n' "$vborder"
  printf '%s\n' "$hborder"

  return 0
}

# clears the screen, but only when
# we're printing to a terminal
function clearscreen {
  if [ -t 1 ]; then
    printf '\033[H\033[2J'
  fi

  return 0
}

# gives the user a chance to read any warnings before the
# screen is cleared (only needed when both are on the terminal)
function pause_for_warnings {
  if [ "$warned" -eq 1 ] && [ -t 1 ] && [ -t 2 ]; then
    read -rp "(Press return to continue)" _ || goodbye
  fi

  warned=0

  return 0
}

# reads a deck's `front=back` lines into cards, skipping blank
# lines and warning about lines it doesn't understand
function read_cards {
  local file="$1"
  local line
  local line_number=0

  cards=()

  while IFS= read -r line || [ -n "$line" ]; do
    line_number=$(( line_number + 1 ))

    # drop control characters (like the \r in CRLF line
    # endings) so they can't mess with the terminal
    line="${line//[[:cntrl:]]/}"

    if [ -z "$line" ]; then
      continue
    fi

    # a card needs an = with some text on both sides of it
    if
      [[ "$line" != *=* ]] ||
      [[ "${line%%=*}" != *[![:space:]]* ]] ||
      [[ "${line#*=}" != *[![:space:]]* ]]
    then
      warn "Skipping line $line_number of $file because it isn't front=back"
      continue
    fi

    cards+=("$line")
  done < "$file"

  return 0
}

# puts the cards in a random order (fisher-yates shuffle)
function shuffle_cards {
  local i
  local j
  local tmp

  for (( i = ${#cards[@]} - 1; i > 0; i-- )); do
    j=$(( RANDOM % (i + 1) ))
    tmp="${cards[i]}"
    cards[i]="${cards[j]}"
    cards[j]="$tmp"
  done

  return 0
}

# shows every card in the deck, one side then the other
function run_cards {
  local cards_name="$1"
  local i
  local card
  local front
  local back

  shuffle_cards

  for (( i = 0; i < ${#cards[@]}; i++ )); do
    card="${cards[i]}"
    front="${card%%=*}"
    back="${card#*=}"

    # randomly pick which side to show first
    if [ "$(( RANDOM % 2 ))" -eq 1 ]; then
      front="${card#*=}"
      back="${card%%=*}"
    fi

    clearscreen

    # print cards name
    printf '%s\n' "$cards_name"

    # print front
    make_card "$front"
    read -rp "(Press return to flip)" _ || goodbye

    # print back
    make_card "$back"

    if [ "$i" -lt "$(( ${#cards[@]} - 1 ))" ]; then
      read -rp "(Press return for next card)" _ || goodbye
    fi
  done

  echo ""
  echo "All done!"
  read -rp "(Press return to exit)" _ || goodbye

  return 0
}

function select_file {
  local files=("$@")
  local -a opts
  local file
  local i
  local msg=""
  local opt
  local selected

  for file in "${files[@]}"; do
    opts+=("$(to_filename "$file")")
  done

  while true; do
    clearscreen
    echo "What would you like to practice?"

    # list the files
    for i in "${!opts[@]}"; do
      echo "$((i+1)). ${opts[$i]}"
    done

    # if there's a feedback message,
    # display that (like an error)
    if [ -n "$msg" ]; then
      echo "$msg"
    fi

    # get the input
    read -rp "> " opt || goodbye

    # make sure the option is in the list
    if
      [[ "$opt" =~ ^[0-9]+$ ]] &&
      [ "${#opt}" -le 9 ] &&
      [ "$(( 10#$opt ))" -ge 1 ] &&
      [ "$(( 10#$opt ))" -le "${#files[@]}" ]
    then
      selected=$(( 10#$opt - 1 ))
    else
      msg="(Please select from the options)"
      continue
    fi

    read_cards "${files[$selected]}"
    pause_for_warnings

    if [ "${#cards[@]}" -eq 0 ]; then
      msg="(${opts[$selected]} has no cards)"
      continue
    fi

    run_cards "${opts[$selected]}"

    return 0
  done
}

function start {
  local dir="$1"
  local -a files

  if [ -z "$dir" ]; then
    die "-d, --dir needs a DIRECTORY containing *.$ext files."
  fi

  if [ ! -d "$dir" ]; then
    die "Directory not found. Are you sure you typed it correctly?"
  fi

  check_locale
  pause_for_warnings

  shopt -s nullglob
  files=("$dir"/*."$ext")
  shopt -u nullglob

  if [ "${#files[@]}" -eq 0 ]; then
    die "No *.$ext files found in $dir. Are you sure this is the right directory?"
  fi

  select_file "${files[@]}"

  return 0
}

# Check if no command is provided

[[ $# -lt 1 ]] && unknown-cmd

# Determine command

case "$1" in
  -d|--dir    ) start "${2-}";;
  -h|--help   ) usage;;
  -v|--version) print_version;;
             *) unknown-cmd;;
esac
