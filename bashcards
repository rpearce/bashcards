#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

pname="bashcards"
ext="bcrds"
version="0.2.0"

# the deck being practiced: fronts[i]=backs[i] is one card,
# and order holds the card indexes in the order to show them
fronts=()
backs=()
order=()

function print_version {
  echo "$version"
  return 0
}

function usage {
  cat <<USAGE
Usage: $pname [OPTION...]

  -d, --dir DIRECTORY    Directory containing *.$ext files
  -h, --help             See this help information
  -v, --version          Current version
USAGE

  return 0
}

# prints a message to stderr, prefixed with the program name
function warn {
  printf '%s: %s\n' "$pname" "$*" >&2
  return 0
}

function unknown-cmd {
  warn "Sorry! I'm not sure what to do. Please use a known option."
  echo "" >&2
  usage >&2
  return 1
}

function dir_required {
  warn "-d, --dir needs a DIRECTORY containing *.$ext files."
  return 1
}

function dir_not_found {
  warn "Directory not found. Are you sure you typed it correctly?"
  return 1
}

function no_files_found {
  warn "No *.$ext files found in $1. Are you sure this is the right directory?"
  return 1
}

# leaves the program when there's no more input (like ctrl-d)
function goodbye {
  echo ""
  exit 0
}

# card borders are measured in characters, which only
# works when the locale is UTF-8, so say so when it isn't
function check_locale {
  local locale="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"

  if [[ "$locale" != *[Uu][Tt][Ff]* ]]; then
    warn "Your locale (${locale:-unset}) isn't UTF-8, so card borders may not line up."
  fi

  return 0
}

# to_filename transforms `/path/to/file.ext` to `file`
function to_filename {
  local full_filename="${1##*/}"
  local filename="${full_filename%.*}"

  printf '%s\n' "$filename"

  return 0
}

# repeat builds a string of one character repeated
# some number of times; for example, `repeat 3 –`
# gives `–––`
function repeat {
  local count="$1"
  local char="$2"
  local spaces

  printf -v spaces '%*s' "$count" ''
  printf '%s\n' "${spaces// /$char}"

  return 0
}

# builds the card output; for example:
# ––––––––––––––––
# |              |
# |  Te quiero.  |
# |              |
# ––––––––––––––––
function make_card {
  local content="$*"
  local hborder
  local vborder

  hborder="$(repeat $(( ${#content} + 6 )) "–")"
  vborder="|$(repeat $(( ${#content} + 4 )) " ")|"

  echo ""
  printf '%s\n' "$hborder"
  printf '%s\n' "$vborder"
  printf '%s\n' "|  $content  |"
  printf '%s\n' "$vborder"
  printf '%s\n' "$hborder"

  return 0
}

# clears the screen, but only when
# we're printing to a terminal
function clearscreen {
  if [ -t 1 ]; then
    printf '\033[H\033[2J'
  fi

  return 0
}

# reads a deck's `front=back` lines into the fronts and
# backs arrays, skipping blank lines and warning about
# lines it doesn't understand
function read_cards {
  local file="$1"
  local line
  local line_number=0

  fronts=()
  backs=()

  while IFS= read -r line || [ -n "$line" ]; do
    line_number=$(( line_number + 1 ))

    # drop control characters (like the \r in CRLF line
    # endings) so they can't mess with the terminal
    line="${line//[[:cntrl:]]/}"

    if [ -z "$line" ]; then
      continue
    fi

    if [[ "$line" != *=* ]]; then
      warn "Skipping line $line_number of $file because it isn't front=back"
      continue
    fi

    fronts+=("${line%%=*}")
    backs+=("${line#*=}")
  done < "$file"

  return 0
}

# fills the order array with the card indexes
# in a random order (fisher-yates shuffle)
function shuffle_cards {
  local count=${#fronts[@]}
  local i
  local j
  local tmp

  order=()

  for (( i = 0; i < count; i++ )); do
    order[i]=$i
  done

  for (( i = count - 1; i > 0; i-- )); do
    j=$(( RANDOM % (i + 1) ))
    tmp=${order[i]}
    order[i]=${order[j]}
    order[j]=$tmp
  done

  return 0
}

# shows every card in the deck, front then back
function run_cards {
  local cards_name=$1
  local count=${#fronts[@]}
  local output_name
  local i
  local index
  local front
  local back

  output_name="$(to_filename "$cards_name")"

  shuffle_cards

  for (( i = 0; i < count; i++ )); do
    index=${order[i]}
    front="${fronts[index]}"
    back="${backs[index]}"

    # randomly pick which side to show first
    if [ "$(( RANDOM % 2 ))" -eq 1 ]; then
      front="${backs[index]}"
      back="${fronts[index]}"
    fi

    clearscreen

    # print cards name
    printf '%s\n' "$output_name"

    # print front
    make_card "$front"
    read -rp "(Press return to flip)" _ || goodbye

    # print back
    make_card "$back"

    if [ "$i" -lt "$(( count - 1 ))" ]; then
      read -rp "(Press return for next card)" _ || goodbye
    fi
  done

  echo ""
  echo "All done!"
  read -rp "(Press return to exit)" _ || goodbye

  exit 0
}

function select_file {
  local msg="$1"
  shift
  local files=("$@")
  local -a opts
  local file
  local i
  local opt
  local selected_file

  for file in "${files[@]}"; do
    opts+=("$(to_filename "$file")")
  done

  clearscreen
  echo "What would you like to practice?"

  # list the files
  for i in "${!opts[@]}"; do
    echo "$((i+1)). ${opts[$i]}"
  done

  # if there's a feedback message,
  # display that (like an error)
  if [ -n "$msg" ]; then
    echo "$msg"
  fi

  # get the input
  read -rp "> " opt || goodbye

  # make sure the option is in
  # the list and then continue
  if
    [[ "$opt" =~ ^[0-9]+$ ]] &&
    [ "${#opt}" -le 9 ] &&
    [ "$(( 10#$opt ))" -gt 0 ] &&
    [ "$(( 10#$opt ))" -le "${#files[@]}" ]
  then
    selected_file="${files[$(( 10#$opt - 1 ))]}"

    read_cards "$selected_file"

    if [ "${#fronts[@]}" -eq 0 ]; then
      select_file "($(to_filename "$selected_file") has no cards)" "${files[@]}"
    else
      run_cards "$selected_file"
    fi
  else
    select_file "(Please select from the options)" "${files[@]}"
  fi

  return 0
}

function start {
  local dir="$1"
  local -a files

  if [ -d "$dir" ]; then
    check_locale

    shopt -s nullglob
    files=("$dir"/*."$ext")
    shopt -u nullglob

    if [ "${#files[@]}" -eq 0 ]; then
      no_files_found "$dir"
    fi

    select_file "" "${files[@]}"

    return 0
  else
    dir_not_found
  fi
}

# Check if no command is provided

[[ $# -lt 1 ]] && unknown-cmd

# Determine command

case "$1" in
  -d|--dir    ) [[ -z "${2-}" ]] && dir_required; start "$2";;
  -h|--help   ) usage;;
  -v|--version) print_version;;
             *) unknown-cmd;;
esac
