#!/usr/bin/env bash

set -eou pipefail

# which release to install, where to put it, and where to
# download it from (point RAW_URL at a mirror or a fork to
# install from somewhere else)
VERSION="${BASHCARDS_VERSION:-0.2.0}"
PREFIX="${PREFIX:-/usr/local}"
RAW_URL="${BASHCARDS_RAW_URL:-https://raw.githubusercontent.com/rpearce/bashcards}"

RELEASE_URL="$RAW_URL/v$VERSION"
TMP_DIR="$(mktemp -d)"

trap 'rm -rf "$TMP_DIR"' EXIT

install_bashcards() {
  # download everything first, so a failed download
  # can't leave a half-written bashcards behind
  curl -fsSL "$RELEASE_URL/bashcards" -o "$TMP_DIR/bashcards"
  curl -fsSL "$RELEASE_URL/bashcards.1" -o "$TMP_DIR/bashcards.1"

  install -d "$PREFIX/bin" "$PREFIX/share/man/man1"
  install -m 0755 "$TMP_DIR/bashcards" "$PREFIX/bin/bashcards"
  install -m 0644 "$TMP_DIR/bashcards.1" "$PREFIX/share/man/man1/bashcards.1"

  echo "Installed $PREFIX/bin/bashcards and its man page from $RELEASE_URL"
}

install_bashcards
